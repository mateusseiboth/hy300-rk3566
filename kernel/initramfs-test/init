#!/bin/sh
# /init do initramfs de teste do marco 1 (kernel 6.1 bootando pela partição recovery).
#
# 1. monta proc, sys, dev e debugfs (nada do eMMC é montado);
# 2. apaga o bootloader_message da `misc` só se o comando começar com "boot-recovery",
#    para o U-Boot não voltar à recovery no próximo boot;
# 3. espera os drivers terminarem de subir e escreve um relatório no /dev/kmsg, que vai
#    para o console do pstore (lido depois pelo kernel de fábrica);
# 4. ~20 s depois do início faz o reset de emergência (sysrq b): reboot quente, motivo
#    normal, e o U-Boot volta para o Android de fábrica com a RAM (e o log) preservada.
#    O sysrq b não passa pelo shutdown dos drivers. No primeiro teste no aparelho o
#    `reboot -f` apagou a ventoinha (shutdown do gpio-leds) e o reset não aconteceu.
#
# Com hy300.shutdown_debug=1 na cmdline o fim usa `reboot -f` com o initcall_debug ligado:
# o kernel registra "<dispositivo>: shutdown" antes do shutdown de cada um, e a última linha
# no pstore mostra onde o reboot trava. Se travar, o watchdog reinicia (ou desliga) o SoC.
#
# Logo no começo o watchdog de hardware é armado e nunca mais alimentado: se qualquer
# coisa travar (inclusive o próprio reset), ele reinicia o SoC a quente em WATCHDOG_TIMEOUT
# segundos e o log no pstore sobrevive.
#
# A única escrita no eMMC é a do passo 2.
#
# Com hy300.wifi=1 o fim é outro (main_wifi): depois do relatório o /init sobe o Wi-Fi
# (AIC8800D80), põe o IP fixo, abre o telnetd na porta 23 e fica no ar alimentando o
# watchdog a cada WATCHDOG_FEED_WIFI segundos. Reinicia sozinho (sysrq b) no prazo de
# hy300.wifi_limit segundos (padrão 900), ou WIFI_FAIL_GRACE segundos depois de uma falha.
# `touch /tmp/hy300-ficar` pelo telnet desliga o reinício automático.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
# shellcheck source=hy300-test.sh
. /lib/hy300-test.sh
# shellcheck source=hy300-wifi.sh
. /lib/hy300-wifi.sh

REPORT_AT=10
REBOOT_AT=20
SAFETY_REBOOT_AT=45
WATCHDOG_TIMEOUT=60
WATCHDOG=/dev/watchdog
WATCHDOG_FEED_MARCO1=3600
WATCHDOG_FEED_WIFI=10
WIFI_LIMIT_DEFAULT=900
WIFI_FAIL_GRACE=120
WIFI_IFACE_WAIT=20
WIFI_ASSOC_WAIT=60
WIFI_STATUS_EVERY=15

mount_basics() {
	mount -t proc proc /proc
	mount -t sysfs sysfs /sys
	mount -t devtmpfs devtmpfs /dev 2>/dev/null
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	mount -t pstore pstore /sys/fs/pstore 2>/dev/null
	echo on >/proc/sys/kernel/printk_devkmsg
}

log() {
	echo "hy300: [init] $*" >>"$KMSG"
}

# Segundos desde o boot; 0 se /proc não estiver legível (o reboot de segurança precisa
# de um número).
read_uptime() {
	seconds=$(cut -d. -f1 /proc/uptime 2>/dev/null)
	echo "${seconds:-0}"
}

sleep_until() {
	now=$(read_uptime)
	[ "$now" -lt "$1" ] || return 0
	sleep $(($1 - now))
}

# Reset de emergência: sem o shutdown dos drivers, direto para o handler de restart.
reboot_now() {
	log "$1"
	sync
	echo b >/proc/sysrq-trigger
}

is_shutdown_debug() {
	grep -qw 'hy300.shutdown_debug=1' /proc/cmdline
}

reboot_with_shutdown_log() {
	echo 1 >/sys/module/kernel/parameters/initcall_debug
	log "$1"
	sync
	reboot -f
}

finish() {
	is_shutdown_debug && reboot_with_shutdown_log "marco1: fim, reboot -f com initcall_debug (t=$(read_uptime) s)"
	reboot_now "marco1: fim, sysrq b (t=$(read_uptime) s)"
}

# O busybox `watchdog` alimenta ao abrir e depois a cada $1 segundos. No marco 1 ($1 =
# WATCHDOG_FEED_MARCO1, uma hora) o watchdog dispara WATCHDOG_TIMEOUT segundos depois daqui,
# se nada reiniciar antes. No modo Wi-Fi ele é alimentado de verdade.
arm_watchdog() {
	[ -c "$WATCHDOG" ] || { log "watchdog: $WATCHDOG ausente"; return; }
	watchdog -T "$WATCHDOG_TIMEOUT" -t "$1" "$WATCHDOG" || { log "watchdog: falha ao armar"; return; }
	log "watchdog: armado, dispara em $WATCHDOG_TIMEOUT s, alimentado a cada $1 s"
}

# Se algo travar no relatório, o reboot acontece mesmo assim.
start_safety_reboot() {
	(sleep_until "$1" && reboot_now "reboot de segurança (t=$1 s)") &
}

handle_misc() {
	misc=$(wait_for_partition misc 15) || { log "misc: partição não encontrada"; return; }
	is_misc_size_expected "$misc" || { log "misc: $misc com tamanho inesperado, intocada"; return; }
	log "misc: /dev/$misc"
	clear_bcb_if_recovery "/dev/$misc" | send_lines_to_kmsg misc
}

list_named_partitions() {
	for uevent in /sys/class/block/*/uevent; do
		name=$(grep '^PARTNAME=' "$uevent" | cut -d= -f2)
		[ -n "$name" ] || continue
		dir=$(dirname "$uevent")
		echo "$(basename "$dir") $name $(cat "$dir/size") setores"
	done
}

show_files() {
	for file in "$@"; do
		[ -r "$file" ] || continue
		echo "$file: $(tr '\000\n' '  ' <"$file")"
	done
}

show_drm() {
	ls /sys/class/drm
	for connector in /sys/class/drm/card*-*; do
		[ -d "$connector" ] || continue
		show_files "$connector/status" "$connector/enabled" "$connector/modes"
	done
}

show_thermal() {
	for zone in /sys/class/thermal/thermal_zone*; do
		[ -d "$zone" ] || continue
		echo "$(cat "$zone/type") $(cat "$zone/temp")"
	done
}

show_input() {
	grep -E '^(N|H):' /proc/bus/input/devices
}

show_mmc() {
	show_files /sys/class/mmc_host/*/mmc*/name /sys/class/mmc_host/*/mmc*/type
	cat /sys/kernel/debug/mmc*/ios
}

write_report() {
	report_section versao "$KMSG" cat /proc/version
	report_section cmdline "$KMSG" cat /proc/cmdline
	report_section modelo "$KMSG" show_files /sys/firmware/devicetree/base/model
	report_section memoria "$KMSG" head -n 5 /proc/meminfo
	report_section iomem "$KMSG" cat /proc/iomem
	report_section particoes "$KMSG" cat /proc/partitions
	report_section nomes "$KMSG" list_named_partitions
	report_section mmc "$KMSG" show_mmc
	report_section drm "$KMSG" show_drm
	report_section backlight "$KMSG" show_files /sys/class/backlight/*/brightness /sys/class/backlight/*/actual_brightness
	report_section entrada "$KMSG" show_input
	report_section leds "$KMSG" ls /sys/class/leds
	report_section temperatura "$KMSG" show_thermal
	report_section reguladores "$KMSG" cat /sys/kernel/debug/regulator/regulator_summary
	report_section gpio "$KMSG" cat /sys/kernel/debug/gpio
	report_section adiados "$KMSG" cat /sys/kernel/debug/devices_deferred
	report_section interrupcoes "$KMSG" cat /proc/interrupts
	report_section pstore "$KMSG" ls -l /sys/fs/pstore
}

wifi_log() {
	echo "hy300: [wifi] $*" >>"$KMSG"
}

# Encurta o prazo para WIFI_FAIL_GRACE segundos: a mensagem fica na tela e o aparelho volta
# ao Android sozinho.
fail_wifi() {
	wifi_error=$(echo "$1" | tr '\n' ' ')
	wifi_log "FALHOU: $wifi_error"
	shorten_deadline "$WIFI_DEADLINE_FILE" $(($(read_uptime) + WIFI_FAIL_GRACE))
	return 1
}

# Quando o prazo chega: kill -9 no daemon do watchdog (sem o fechamento mágico, o watchdog
# segue armado e reseta se o sysrq b travar) e reset de emergência.
start_deadline_watch() {
	(
		announced=
		while :; do
			sleep 5
			[ -e "$WIFI_STAY_FILE" ] && [ -z "$announced" ] && { wifi_log "reinício automático desligado ($WIFI_STAY_FILE)"; announced=1; }
			now=$(read_uptime)
			is_deadline_reached "$now" "$(read_deadline "$WIFI_DEADLINE_FILE")" "$WIFI_STAY_FILE" || continue
			for pid in $(pidof watchdog); do kill -9 "$pid"; done
			reboot_now "wifi: fim do prazo, sysrq b (t=$now s)"
		done
	) &
}

# Só informativo: há roteador que não responde ao ping.
report_gateway() {
	ping -c 1 -W 3 "$WIFI_GATEWAY" >/dev/null 2>&1 || { wifi_log "gateway $WIFI_GATEWAY não respondeu ao ping"; return; }
	wifi_log "gateway $WIFI_GATEWAY responde"
}

bring_up_wifi() {
	wifi_log "carregando aic8800_bsp e aic8800_fdrv"
	result=$(load_wifi_modules "$WIFI_MODULE_DIR" "$WIFI_FIRMWARE_DIR" 2>&1) || { fail_wifi "$result"; return 1; }
	iface=$(wait_for_wireless_iface "$WIFI_IFACE_WAIT") || { fail_wifi "nenhuma interface sem fio em $WIFI_IFACE_WAIT s"; return 1; }
	wifi_log "interface $iface, iniciando o wpa_supplicant"
	start_wpa_supplicant "$iface" "$WIFI_WPA_CONF" "$WIFI_WPA_LOG" || { fail_wifi "wpa_supplicant não iniciou"; return 1; }
	state=$(wait_for_wpa_completed "$iface" "$WIFI_ASSOC_WAIT") || { fail_wifi "sem conexão em $WIFI_ASSOC_WAIT s (estado $state)"; return 1; }
	wifi_log "conectado"
	configure_static_ip "$iface" "$WIFI_NET_CONF" || { fail_wifi "não foi possível configurar o IP"; return 1; }
	announce_ip "$iface" "$(read_iface_ip "$iface")"
	report_gateway
	start_telnetd "$WIFI_TELNET_PORT" || { fail_wifi "telnetd não iniciou"; return 1; }
	wifi_log "telnetd na porta $WIFI_TELNET_PORT"
}

show_wifi_status() {
	now=$(read_uptime)
	deadline=$(read_deadline "$WIFI_DEADLINE_FILE")
	[ -n "$wifi_error" ] && { wifi_log "FALHOU: $wifi_error; $(build_countdown "$now" "$deadline" "$WIFI_STAY_FILE")"; return; }
	wifi_log "$(build_wifi_status "$(read_iface_ip "$iface")" "$now" "$deadline" "$WIFI_STAY_FILE")"
}

main_wifi() {
	arm_watchdog "$WATCHDOG_FEED_WIFI"
	start=$(read_uptime)
	limit=$(read_cmdline_number hy300.wifi_limit "$WIFI_LIMIT_DEFAULT")
	echo $((start + limit)) >"$WIFI_DEADLINE_FILE"
	start_deadline_watch
	log "wifi: início (t=$start s), reinicia em $limit s; touch $WIFI_STAY_FILE para ficar"
	handle_misc
	sleep_until $((start + REPORT_AT))
	log "relatório: início"
	write_report
	log "relatório: fim"
	wifi_error=
	bring_up_wifi
	while :; do
		show_wifi_status
		sleep "$WIFI_STATUS_EVERY"
	done
}

main() {
	mount_basics
	is_wifi_mode && main_wifi
	arm_watchdog "$WATCHDOG_FEED_MARCO1"
	start=$(read_uptime)
	start_safety_reboot $((start + SAFETY_REBOOT_AT))
	log "marco1: início (t=$start s)"
	handle_misc
	sleep_until $((start + REPORT_AT))
	log "relatório: início"
	write_report
	log "relatório: fim"
	sleep_until $((start + REBOOT_AT))
	finish
	# O sysrq b não volta; se voltar, o reboot de segurança e o watchdog ainda estão de pé.
	while :; do sleep 60; done
}

main
