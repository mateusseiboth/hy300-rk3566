# HY300: animação de boot com log ao vivo (hy300-rk3566/android/bootlog). Substitui o serviço
# bootanim do frameworks/base (/system/etc/init/bootanim.rc); "override" porque o /product é lido
# depois do /system. Domínio próprio (hy300_bootlog, sepolicy/system_ext da árvore do aparelho): o
# sh, o logcat e o EGL não cabem no domínio bootanim; o bootanimation do logo volta a ele.
service bootanim /system/bin/sh /product/media/bootlog/bootlog.sh
    override
    class core animation
    user root
    group root graphics audio log readproc
    seclabel u:r:hy300_bootlog:s0
    disabled
    oneshot
    ioprio rt 0
    task_profiles MaxPerformance

# Marca do 1º quadro (BOOTLOG_READY do bootlog.sh).
on early-init
    mkdir /dev/hy300-bootlog 0700 root root
