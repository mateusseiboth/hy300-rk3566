<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.hy300.settings"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Motor de foco no LineageOS: o nó /sys/class/motor_cc/motor_cc/motor é
         system:vendor_hy300_motor 0660, e quem tem esta permissão roda com esse gid
         (hy300-focus-motor.xml da árvore do aparelho). Na ROM de fábrica o nó é 0777 e a
         permissão não muda nada. -->
    <permission
        android:name="io.github.hy300.settings.permission.FOCUS_MOTOR"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.hy300.settings.permission.FOCUS_MOTOR" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Só para ligar o serviço de acessibilidade da tecla F12 pelo próprio app.
         Concedida por privapp-permissions (priv-app) ou "pm grant". -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Listar os apps para "abrir ao ligar" (Android 11+). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.HY300.Settings">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HY300.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Entrada no menu principal do TvSettings (com.android.tv.set). O item "sound"
                 do main_prefs.xml fica visível quando um app de SISTEMA trata esta ação; título,
                 resumo e ícone vêm de sound_pref_title / sound_pref_summary / sound_icon. -->
            <intent-filter>
                <action android:name="com.android.tv.set.SOUND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- O mesmo item no TvSettings do AOSP/LineageOS (com.android.tv.settings). -->
            <intent-filter>
                <action android:name="com.android.tv.settings.SOUND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.hy300.settings.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- android.settings.SETTINGS: o TvSettings da ROM de fábrica (com.android.tv.set) não
             declara esta ação, e a única outra activity que a tratava era a tela da TXCZ.
             Desligada por padrão: no LineageOS o com.android.tv.settings já trata a ação, e com
             as duas o launcher abre o seletor "Concluir a ação usando". Na ROM de fábrica,
             system/disable-txcz-settings.sh liga o componente com "pm enable". -->
        <activity
            android:name=".AndroidSettingsActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:priority="1">
                <action android:name="android.settings.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KeystoneActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.HY300.Fullscreen" />

        <activity
            android:name=".FocusActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.HY300.Fullscreen" />

        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:theme="@style/Theme.HY300.Fullscreen" />

        <service
            android:name=".AutoKeystoneService"
            android:exported="false" />

        <!-- directBootAware: no boot, antes do desbloqueio, o AccessibilityManagerService ignora
             serviços que não são e regrava enabled_accessibility_services sem eles (o atalho
             sumia a cada reboot). O serviço não usa armazenamento protegido por credencial. -->
        <service
            android:name=".F12KeyService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_f12" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.txcz.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
